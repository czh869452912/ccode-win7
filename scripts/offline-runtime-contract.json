{
  "schema_version": 2,
  "win7_evidence_schema_version": 1,
  "description": "Target-aware runtime capabilities and release gates for offline portable bundles.",
  "targets": {
    "win7-x64-portable": {
      "always_requires": [
        "runtime.python"
      ],
      "always_gates": [
        "runtime_contract"
      ]
    }
  },
  "launchers": [
    {
      "id": "cli",
      "path": "embedagent.cmd"
    },
    {
      "id": "tui",
      "path": "embedagent-tui.cmd"
    },
    {
      "id": "gui-command",
      "path": "embedagent-gui.cmd"
    },
    {
      "id": "gui-native-user",
      "path": "EmbedAgent.exe"
    },
    {
      "id": "gui-native-cli",
      "path": "embedagent-gui.exe"
    },
    {
      "id": "cli-smoke",
      "path": "validate-cli-smoke.cmd"
    },
    {
      "id": "cpp-smoke",
      "path": "validate-cpp-smoke.cmd"
    },
    {
      "id": "gui-smoke",
      "path": "validate-gui-smoke.cmd"
    }
  ],
  "release_gates": [
    {
      "id": "runtime_contract",
      "description": "Static and dynamic validation of every selected bundled external runtime component.",
      "applies_when": {
        "all_of": []
      },
      "validators": [
        "scripts/validate-offline-bundle.ps1",
        "scripts/check-bundle-dependencies.py"
      ],
      "allow_system_tool_fallback": false
    },
    {
      "id": "win7_cli_smoke",
      "description": "Target-machine CLI gate using only the bundled Python runtime and selected runtime components.",
      "applies_when": {
        "all_of": [
          "shell.cli",
          "assurance.release"
        ]
      },
      "script": "tools/validation/validate-cli-smoke.py",
      "launcher": "validate-cli-smoke.cmd",
      "launcher_ids": [
        "cli-smoke"
      ],
      "manual_on_win7": true,
      "report_schema_version": 1,
      "expected_runtime_source": "bundle"
    },
    {
      "id": "cpp_smoke_workspace",
      "description": "Compile the bundled C smoke workspace with the bundled Clang toolchain; release proof must not fall back to PATH.",
      "applies_when": {
        "all_of": [
          "component.workflow.workflow-cpp",
          "runtime.toolchain.clang"
        ]
      },
      "script": "tools/validation/validate-cpp-smoke.py",
      "launcher": "validate-cpp-smoke.cmd",
      "launcher_ids": [
        "cpp-smoke"
      ],
      "workspace": "data/workspace-template",
      "required_tool": "clang",
      "allow_system_tool_fallback": false
    },
    {
      "id": "gui_headless_smoke",
      "description": "Exercise GUI backend, session activation, task API, tool events, permission/user-input flows, and /review against the bundle.",
      "applies_when": {
        "all_of": [
          "shell.gui",
          "runtime.renderer.webview2"
        ]
      },
      "script": "tools/validation/validate-gui-smoke.py",
      "launcher": "validate-gui-smoke.cmd",
      "launcher_ids": [
        "gui-smoke"
      ],
      "args": [
        "--require-fixed-webview2"
      ],
      "expected_runtime_source": "bundle"
    },
    {
      "id": "win7_windowed_gui_smoke",
      "description": "Manual target-machine gate for Windows 7 SP1 using bundled Fixed Version WebView2 109.",
      "applies_when": {
        "all_of": [
          "shell.gui",
          "runtime.renderer.webview2",
          "assurance.release"
        ]
      },
      "script": "tools/validation/validate-gui-smoke.py",
      "launcher": "validate-gui-smoke.cmd",
      "launcher_ids": [
        "gui-smoke"
      ],
      "args": [
        "--windowed",
        "--auto-close-seconds",
        "8",
        "--require-fixed-webview2"
      ],
      "manual_on_win7": true,
      "report_schema_version": 1,
      "webview2_fixed_runtime_major": 109,
      "expected_renderer": "edgechromium",
      "expected_runtime_source": "bundle"
    }
  ],
  "runtime_components": [
    {
      "id": "python",
      "provides": [
        "runtime.python"
      ],
      "asset_ids": [
        "python_embedded_x64"
      ],
      "paths": [
        "runtime/python/python.exe"
      ],
      "python_feature_ids": [],
      "launcher_ids": [
        "cli"
      ],
      "managed_tools": [
        {
          "id": "python",
          "category": "runtime",
          "paths": [
            "runtime/python/python.exe"
          ],
          "command_names": [
            "python",
            "python.exe"
          ],
          "dynamic_check": [
            "--version"
          ],
          "notes": "Used by launchers and generated local validation recipes."
        }
      ]
    },
    {
      "id": "mingit",
      "provides": [
        "vcs.git",
        "shell.bash"
      ],
