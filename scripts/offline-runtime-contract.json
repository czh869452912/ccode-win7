{
  "schema_version": 1,
  "description": "Runtime-invoked tools that must be present in the offline portable bundle.",
  "release_gates": [
    {
      "id": "runtime_contract",
      "description": "Static and dynamic validation of every runtime-invoked bundled external tool declared by this contract.",
      "validators": [
        "scripts/validate-offline-bundle.ps1",
        "scripts/check-bundle-dependencies.py"
      ],
      "allow_system_tool_fallback": false
    },
    {
      "id": "cpp_smoke_workspace",
      "description": "Compile the bundled C smoke workspace with the bundled Clang toolchain; release proof must not fall back to PATH.",
      "script": "tools/validation/validate-cpp-smoke.py",
      "launcher": "validate-cpp-smoke.cmd",
      "workspace": "data/workspace-template",
      "required_tool": "clang",
      "allow_system_tool_fallback": false
    },
    {
      "id": "gui_headless_smoke",
      "description": "Exercise GUI backend, session activation, task API, tool events, permission/user-input flows, and /review against the bundle.",
      "script": "tools/validation/validate-gui-smoke.py",
      "launcher": "validate-gui-smoke.cmd",
      "args": [
        "--require-fixed-webview2"
      ],
      "expected_runtime_source": "bundle"
    },
    {
      "id": "win7_windowed_gui_smoke",
      "description": "Manual target-machine gate for Windows 7 SP1 using bundled Fixed Version WebView2 109.",
      "script": "tools/validation/validate-gui-smoke.py",
      "launcher": "validate-gui-smoke.cmd",
      "args": [
        "--windowed",
        "--auto-close-seconds",
        "8",
        "--require-fixed-webview2"
      ],
      "manual_on_win7": true,
      "webview2_fixed_runtime_major": 109,
      "expected_renderer": "edgechromium",
      "expected_runtime_source": "bundle"
    }
  ],
  "required_tools": [
    {
      "id": "python",
      "component": "python_runtime",
      "category": "runtime",
      "paths": [
        "runtime/python/python.exe"
      ],
      "command_names": [
        "python",
        "python.exe"
      ],
      "dynamic_check": [
        "--version"
      ],
      "notes": "Used by launchers and generated local validation recipes."
    },
    {
      "id": "git",
      "component": "mingit_portable",
      "category": "vcs",
      "alternatives": [
        {
          "paths": [
            "bin/git/cmd/git.exe"
          ]
        },
        {
          "paths": [
            "bin/git/bin/git.exe"
          ]
        },
        {
          "paths": [
            "bin/git/git.exe"
          ]
        }
      ],
      "command_names": [
        "git",
        "git.exe"
      ],
      "dynamic_check": [
        "--version"
      ],
      "notes": "Used by built-in git tools and workspace intelligence."
    },
    {
      "id": "bash",
      "component": "mingit_portable",
      "category": "shell",
      "alternatives": [
        {
          "paths": [
            "bin/git/bin/bash.exe"
          ]
        },
        {
          "paths": [
            "bin/git/usr/bin/bash.exe"
          ]
        },
        {
          "paths": [
            "bin/git/bin/sh.exe"
          ]
        },
        {
          "paths": [
            "bin/git/usr/bin/sh.exe"
          ]
        }
      ],
      "command_names": [
        "bash",
        "bash.exe",
        "sh",
        "sh.exe"
      ],
      "dynamic_check": [
        "--version"
      ],
      "notes": "Used by the model-facing bash primitive for offline command execution."
    },
    {
      "id": "rg",
      "component": "ripgrep",
      "category": "search",
      "paths": [
        "bin/rg/rg.exe"
      ],
      "command_names": [
        "rg",
        "rg.exe"
      ],
      "dynamic_check": [
        "--version"
      ],
      "notes": "Used by search and discovery workflows."
    },
    {
      "id": "ctags",
      "component": "universal_ctags",
      "category": "symbols",
      "paths": [
        "bin/ctags/ctags.exe"
      ],
      "command_names": [
        "ctags",
        "ctags.exe"
      ],
      "dynamic_check": [
        "--version"
      ],
      "notes": "Used by symbol intelligence."
    },
    {
      "id": "llvm",
      "component": "llvm_clang_bundle",
      "category": "toolchain",
      "paths": [
        "bin/llvm/bin"
      ],
      "command_names": [],
      "children": [
        {
          "id": "clang",
          "path": "bin/llvm/bin/clang.exe",
          "command_names": [
            "clang",
            "clang.exe"
          ],
          "dynamic_check": [
            "--version"
          ]
        },
        {
          "id": "clangxx",
          "path": "bin/llvm/bin/clang++.exe",
          "command_names": [
            "clang++",
            "clang++.exe"
          ],
          "dynamic_check": [
            "--version"
          ]
        },
        {
          "id": "clang_cl",
          "path": "bin/llvm/bin/clang-cl.exe",
          "command_names": [
            "clang-cl",
            "clang-cl.exe"
          ],
          "dynamic_check": [
            "--version"
          ]
        },
        {
          "id": "clang_tidy",
          "path": "bin/llvm/bin/clang-tidy.exe",
          "command_names": [
            "clang-tidy",
            "clang-tidy.exe"
          ],
          "dynamic_check": [
            "--version"
          ]
        },
        {
          "id": "clang_analyzer",
          "path": "bin/llvm/bin/clang-analyzer.bat",
          "command_names": [
            "clang-analyzer",
            "clang-analyzer.bat"
          ]
        },
        {
          "id": "llvm_profdata",
          "path": "bin/llvm/bin/llvm-profdata.exe",
          "command_names": [
            "llvm-profdata",
            "llvm-profdata.exe"
          ],
          "dynamic_check": [
            "--version"
          ]
        },
        {
          "id": "llvm_cov",
          "path": "bin/llvm/bin/llvm-cov.exe",
          "command_names": [
            "llvm-cov",
            "llvm-cov.exe"
          ],
          "dynamic_check": [
            "--version"
          ]
        }
      ],
      "notes": "Used by C/C++ build, static analysis, and coverage workflows."
    }
  ]
}
