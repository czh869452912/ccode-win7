{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EmbedAgent Win7 target evidence",
  "type": "object",
  "required": [
    "schema_version",
    "release_identity_sha256",
    "bundle_plan_sha256",
    "gate_ids",
    "gate_results",
    "machine",
    "blocking_errors"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "release_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bundle_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gate_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "gate_results": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": { "type": "boolean" },
          "runtime_source": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "machine": {
      "type": "object",
      "required": ["os", "service_pack", "architecture"],
      "properties": {
        "os": { "type": "string" },
        "service_pack": { "type": "string" },
        "architecture": { "type": "string" }
      },
      "additionalProperties": true
    },
    "webview2": {
      "type": "object",
      "required": ["major", "runtime_source", "fixed_runtime_exists"],
      "properties": {
        "major": { "type": "integer" },
        "runtime_source": { "type": "string" },
        "fixed_runtime_exists": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "gui": {
      "type": "object",
      "required": ["renderer", "windowed_smoke"],
      "properties": {
        "renderer": { "type": "string" },
        "windowed_smoke": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "string" }
          ]
        }
      },
      "additionalProperties": true
    },
    "cpp_smoke": {
      "type": "object",
      "required": ["ok", "runtime_source", "system_tool_fallback"],
      "properties": {
        "ok": { "type": "boolean" },
        "runtime_source": { "type": "string" },
        "system_tool_fallback": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "command_exit_codes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "integer" }
    },
    "blocking_errors": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gate_ids": { "contains": { "const": "win7_windowed_gui_smoke" } }
        }
      },
      "then": { "required": ["webview2", "gui"] }
    },
    {
      "if": {
        "properties": {
          "gate_ids": { "contains": { "const": "cpp_smoke_workspace" } }
        }
      },
      "then": { "required": ["cpp_smoke"] }
    }
  ],
  "additionalProperties": true
}
